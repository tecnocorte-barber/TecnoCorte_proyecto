# Configuración Django
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=generar-una-clave-larga-y-secreta
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SSL_REDIRECT=False
DJANGO_CSRF_TRUSTED_ORIGINS=
REQUIRE_EMAIL_VERIFICATION=True
EMAIL_VERIFICATION_MINUTES=15
EMAIL_VERIFICATION_RESEND_SECONDS=60

# PostgreSQL
DB_NAME=postgres
DB_USER=usuario
DB_PASSWORD=contraseña
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=0

# Correo SMTP
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=notificaciones@example.com
CONTACT_EMAIL=
SITE_URL=https://tu-dominio-publico.com

# Backups PostgreSQL
BACKUP_EMAIL=
BACKUP_MAX_ATTACHMENT_BYTES=20971520
BACKUP_ENCRYPTION_KEY=generar-con-fernet

# JWT
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# Vercel / producción
# VERCEL_URL la proporciona Vercel automáticamente.
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=tecno-corte-proyecto.vercel.app,.vercel.app
DJANGO_CSRF_TRUSTED_ORIGINS=https://tecno-corte-proyecto.vercel.app
DJANGO_USE_PROXY_SSL=True
DJANGO_SSL_REDIRECT=True
DJANGO_HSTS_SECONDS=31536000
